{
  "name": "jokkoo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-mock-images.mjs",
    "prebuild": "node scripts/sync-mock-images.mjs && node scripts/check-encoding.mjs",
    "dev": "next dev",
    "build": "node -e \"if(process.env.CI || process.env.VERCEL){require('child_process').execSync('node scripts/predeploy-check.mjs', {stdio:'inherit'})}\" && next build",
    "predeploy": "node scripts/predeploy-check.mjs",
    "start": "next start",
    "lint": "node scripts/check-encoding.mjs && eslint",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.12.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "motion-ai": "^14.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
